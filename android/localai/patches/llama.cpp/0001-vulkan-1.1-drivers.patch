 bool ggml_vk_device_is_supported(const vk::PhysicalDevice & vkdev) {
+    // Vulkan 1.1 drivers work through the promoted extensions enabled at
+    // device creation; without these two they would crash on null entry
+    // points or reject the SPIR-V 1.4 shaders, so use the CPU instead.
+    if (vkdev.getProperties().apiVersion < VK_API_VERSION_1_2) {
+        bool timeline = false, spirv14 = false;
+        for (const auto & ep : vkdev.enumerateDeviceExtensionProperties()) {
+            timeline = timeline || strcmp(ep.extensionName, "VK_KHR_timeline_semaphore") == 0;
+            spirv14 = spirv14 || strcmp(ep.extensionName, "VK_KHR_spirv_1_4") == 0;
+        }
+        if (!timeline || !spirv14) {
+            return false;
+        }
+    }
+
     VkPhysicalDeviceFeatures2 device_features2;
